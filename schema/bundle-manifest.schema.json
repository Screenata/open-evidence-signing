{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openevidence.dev/signing/v1/bundle-manifest.schema.json",
  "title": "OES v4.0 Evidence Pack Manifest",
  "description": "Schema for the production ManifestV3 (v4.0) evidence-pack manifest verified by oes-verify. See OPEN-EVIDENCE-SPEC-v1 §8.4 and Appendix D.",
  "type": "object",
  "required": ["version", "files"],
  "properties": {
    "version": { "type": "string", "enum": ["4.0", "2.1"] },
    "title": { "type": "string" },
    "files": {
      "type": "object",
      "properties": {
        "manifest": { "$ref": "#/$defs/fileEntry" },
        "screenshots": { "type": "array", "items": { "$ref": "#/$defs/fileEntry" } },
        "attachments": { "type": "array", "items": { "$ref": "#/$defs/fileEntry" } },
        "comments_txt": { "oneOf": [{ "$ref": "#/$defs/fileEntry" }, { "type": "null" }] },
        "video": {}
      },
      "additionalProperties": true
    },
    "cryptographic_signature": {
      "type": "object",
      "required": ["signature", "publicKeyFingerprint", "algorithm"],
      "properties": {
        "signature": { "type": "string" },
        "signedAt": { "type": "string", "format": "date-time" },
        "publicKeyFingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "algorithm": { "type": "string", "enum": ["RSA-SHA256", "ECDSA-SHA256"] },
        "publicKeyUrl": { "type": "string" },
        "verification_instructions": { "type": "string" },
        "canonicalization": { "const": "sorted-keys-2space" },
        "signed_fields": { "type": "string" },
        "tsaTimestamp": {
          "type": "object",
          "required": ["token", "timestampedAt", "tsaUrl", "serialNumber"],
          "properties": {
            "token": { "type": "string", "contentEncoding": "base64" },
            "timestampedAt": { "type": "string", "format": "date-time" },
            "tsaUrl": { "type": "string" },
            "serialNumber": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "fileEntry": {
      "type": "object",
      "required": ["filename", "sha256"],
      "properties": {
        "filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string" },
        "signature": { "type": "string" },
        "signedAt": { "type": "string" },
        "stepNumber": { "type": "integer" },
        "caption": { "type": "string" },
        "originalName": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
